/build/
/build-*/
/.cache/
/.cmake/
/.vcpkg/
/dist/
*.user
*.autosave

# Runtime data (database/vlms.db, resources/books, resources/members) is mock
# data and is tracked, so the Windows installer build finds it in the checkout.
# Hand-made backups of the live database. These hold real member records
# (names, dates of birth) and must never enter version control.
/database/*.db.bak-*
/database/*.db-journal
/database/*.db-wal
/dist/VLMS_installer_data.zip

# OCR runtime binaries (keep README / .gitkeep; stage locally or on the Windows build PC)
/third_party/tesseract/windows/**
!/third_party/tesseract/windows/.gitkeep
/third_party/tesseract/linux/**
!/third_party/tesseract/linux/.gitkeep

# Local backups of uncommitted work (see _backups/*/MANIFEST.md)
/_backups/

# Isolated git worktrees for feature work
/.worktrees/

# Brainstorming companion scratch (mockups, session state)
/.superpowers/

# Python bytecode from the manual and import scripts
__pycache__/
