/build/
/build-*/
/.cache/
/.cmake/
/.vcpkg/
/dist/
*.user
*.autosave

# Sample runtime data. database/vlms.db is tracked. The cover images and member
# photographs are too large for the repository: they ship as
# VLMS_installer_data.zip on a release, fetched by scripts/fetch_runtime_data.sh
# (or fetch_installer_data.ps1 on Windows).
/resources/books/**
!/resources/books/.gitkeep
/resources/members/**
!/resources/members/.gitkeep
/resources/.installer-data

# Hand-made backups of the live database. These hold real member records
# (names, dates of birth) and must never enter version control.
/database/*.db.bak-*
/database/*.db-journal
/database/*.db-wal
/dist/VLMS_installer_data.zip

# OCR runtime binaries (keep README / .gitkeep; stage locally or on the Windows build PC)
/third_party/tesseract/windows/**
!/third_party/tesseract/windows/.gitkeep
/third_party/tesseract/linux/**
!/third_party/tesseract/linux/.gitkeep

# Local backups of uncommitted work (see _backups/*/MANIFEST.md)
/_backups/

# Isolated git worktrees for feature work
/.worktrees/

# Brainstorming companion scratch (mockups, session state)
/.superpowers/

# Local design specs and plans from the superpowers skills
/docs/superpowers/

# Python bytecode from the manual and import scripts
__pycache__/

# CTest scratch output from running ctest in the source tree
/Testing/

# Per-developer editor settings
/.vscode/

# Runtime files VLMS leaves behind when it stops abruptly
/database/vlms.lock
/resources/**/*.part
/resources/**/*.old

# Local Claude Code settings, hooks, skills and project instructions
/.claude/
